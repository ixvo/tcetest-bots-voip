+/* Cache the negotiated extension once per frame for the HUD, scoreboard and world sprites. */
+static int ixvoVoiceState[10];
+void IXVO_RefreshVoiceHud(void)
+{
+	if (!IXVO_GetVoiceState(ixvoVoiceState)) memset(ixvoVoiceState, 0, sizeof(ixvoVoiceState));
+}
+
+int IXVO_SpeakingChannel(int slot)
+{
+	unsigned bit;
+	if (slot < 0 || slot >= MAX_CLIENTS || ixvoVoiceState[4] == 0 ||
+	    !ixvoVoiceState[5] || !cgs.clientinfo[slot].infoValid) return 0;
+	if (slot == cg.clientNum && ixvoVoiceState[2]) return ixvoVoiceState[9] ? 2 : 1;
+	bit = 1u << (slot & 31);
+	if (ixvoVoiceState[slot >> 5] & bit) return 1;
+	if ((ixvoVoiceState[7 + (slot >> 5)] & bit) &&
+	    cgs.clientinfo[slot].team == cgs.clientinfo[cg.clientNum].team) return 2;
+	return 0;
+}
+
+static void IXVO_DrawVoiceHud(void)
+{
+	int slot, y = 92;
+	if (!ixvo_voiceHud.integer || !cg.snap) return;
+	if (ixvoVoiceState[2])
+	{
+		CG_DrawSmallStringColor(8, y, va("%s mic %d%%", ixvoVoiceState[9] ? "Nearby" : "Radio", ixvoVoiceState[3]), colorWhite);
+		y += 14;
+	}
+	for (slot = 0; slot < MAX_CLIENTS && y < 240; ++slot)
+	{
+		int channel = IXVO_SpeakingChannel(slot);
+		if (!channel || slot == cg.clientNum) continue;
+		CG_DrawSmallStringColor(8, y, va("%s: %s", channel == 2 ? "Nearby" : "Radio", cgs.clientinfo[slot].name), colorWhite);
+		y += 14;
+	}
+}
