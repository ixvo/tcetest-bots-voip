diff --git a/etlegacy/src/qcommon/ixvo_voip.h b/etlegacy/src/qcommon/ixvo_voip.h
new file mode 100644
index 0000000000000000000000000000000000000000..fc25f1d835a08966041ab91df9dffb9f2cb793a2
--- /dev/null
+++ b/etlegacy/src/qcommon/ixvo_voip.h
@@ -0,0 +1,42 @@
+/*
+ * TrueCombat: Platinum - native voice chat, wire format shared by client and server.
+ *
+ * Voice travels inside the normal game packets, so it needs no extra port.
+ *   client -> server  clc_voipOpus: byte gen, short seq, byte frames, frames x {short len, len bytes}
+ *   server -> client  svc_voipOpus: byte sender, byte gen, short seq, byte frames,
+ *                     [local only: 3 x short speaker origin], frames x {short len, len bytes}
+ * Bit 7 of gen (IXVO_VOIP_LOCAL) marks local voice: spoken out loud, heard in 3D by everyone
+ * nearby (enemies too). Without it the message is team radio.
+ * Every frame is 20 ms of 48 kHz mono Opus. "gen" changes with every new transmission, so the
+ * receiver resets its decoder; "seq" is the number of the first frame and lets the receiver
+ * conceal lost frames.
+ *
+ * Serverinfo advertises ixvo_voice_api 1 and sv_voice 1; clients opt in with
+ * ixvo_voice_client 1 and cl_voip 1. Peers without support keep the stock protocol.
+ *
+ * Who hears whom is decided by the game module (trap_IxvoVoiceMatrix): for radio, team voice, dead
+ * players only to dead teammates, spectators to spectators, everyone in warmup; for local voice,
+ * living speakers to everyone within range.
+ */
+#ifndef INCLUDE_IXVO_VOIP_H
+#define INCLUDE_IXVO_VOIP_H
+
+#define IXVO_VOIP_RATE          48000
+#define IXVO_VOIP_FRAME_SAMPLES 960      ///< 20 ms
+#define IXVO_VOIP_MAX_FRAMES    3        ///< frames in one message
+#define IXVO_VOIP_MAX_BYTES     256      ///< one Opus frame (24 kbps is about 60 bytes)
+#define IXVO_VOIP_QUEUE         32       ///< messages waiting for one receiver
+#define IXVO_VOIP_STREAM_BASE   64       ///< raw sound stream of slot 0 (64 + slot, below MAX_RAW_STREAMS 128)
+#define IXVO_VOIP_LOCAL         0x80     ///< gen bit: local (proximity) voice
+#define IXVO_VOIP_GEN_MASK      0x7f
+
+typedef struct
+{
+	unsigned char sender, gen, frames;
+	unsigned short seq;
+	short origin[3];                    ///< local voice: where the speaker stands
+	unsigned short len[IXVO_VOIP_MAX_FRAMES];
+	unsigned char data[IXVO_VOIP_MAX_FRAMES][IXVO_VOIP_MAX_BYTES];
+} ixvoVoipPacket_t;
+
+#endif
