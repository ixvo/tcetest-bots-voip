+/**
+ * @brief CL_VoipInit
+ */
+void CL_VoipInit(void)
+{
+	Cvar_Get("ixvo_voice_client", "1", CVAR_ROM | CVAR_USERINFO);
+	cl_voip              = Cvar_Get("cl_voip", "1", CVAR_ARCHIVE | CVAR_USERINFO);
+	cl_voipVolume        = Cvar_Get("cl_voipVolume", "1", CVAR_ARCHIVE);
+	cl_voipMicGain       = Cvar_Get("cl_voipMicGain", "1", CVAR_ARCHIVE);
+	cl_voipUseVAD        = Cvar_Get("cl_voipUseVAD", "0", CVAR_ARCHIVE);
+	cl_voipVADThreshold  = Cvar_Get("cl_voipVADThreshold", "0.02", CVAR_ARCHIVE);
+	// 0.39.1: the old 0.08 default was above normal speech, so voice activation never sent; move saved profiles once
+	if (!Cvar_VariableIntegerValue("cl_voipVADLevel2"))
+	{
+		if (!Q_stricmp(cl_voipVADThreshold->string, "0.08"))
+		{
+			Cvar_Set("cl_voipVADThreshold", "0.02");
+		}
+		Cvar_Get("cl_voipVADLevel2", "1", CVAR_ARCHIVE);
+		Cvar_Set("cl_voipVADLevel2", "1");
+	}
+	cl_voipCaptureDevice = Cvar_Get("cl_voipCaptureDevice", "", CVAR_ARCHIVE);
+	Cvar_Get("cl_voipMuteEnemies", "0", CVAR_ARCHIVE | CVAR_USERINFO); // read by the server from the userinfo
+	cl_voipRadio         = Cvar_Get("cl_voipRadio", "1", CVAR_ARCHIVE);
+	cl_voipTestTone      = Cvar_Get("cl_voipTestTone", "0", CVAR_TEMP);
+	cl_voipDebug         = Cvar_Get("cl_voipDebug", "0", CVAR_TEMP);
+	cl_voipMicTest       = Cvar_Get("cl_voipMicTest", "0", CVAR_TEMP);
+	cl_voipMeter         = Cvar_Get("cl_voipMeter", "", CVAR_ROM | CVAR_TEMP);
+	ui_voipDevice        = Cvar_Get("ui_voipDevice", "", CVAR_ROM | CVAR_TEMP);
+	CL_VoipDeviceLabel();
+	cl_voipCaptureDevice->modified = qfalse;
+	Cmd_AddCommand("+voip", CL_VoipDown_f, "Push to talk (voice chat).");
+	Cmd_AddCommand("-voip", CL_VoipUp_f, "Push to talk (voice chat).");
+	Cmd_AddCommand("+voiplocal", CL_VoipLocalDown_f, "Talk out loud: everyone nearby hears you, enemies too.");
+	Cmd_AddCommand("-voiplocal", CL_VoipLocalUp_f, "Talk out loud: everyone nearby hears you, enemies too.");
+	Cmd_AddCommand("voip_devices", CL_VoipDevices_f, "Lists the microphones voice chat can use.");
+	Cmd_AddCommand("voip_nextDevice", CL_VoipNextDevice_f, "Selects the next microphone for voice chat.");
+	CL_VoipReset();
+}
