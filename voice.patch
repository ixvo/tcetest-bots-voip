+/**
+ * @brief CL_ParseVoip reads one svc_voipOpus message (CL_ParseServerMessage).
+ */
+void CL_ParseVoip(msg_t *msg)
+{
+	const int      sender = MSG_ReadByte(msg);
+	const int      genByte = MSG_ReadByte(msg);
+	const int      gen     = genByte & IXVO_VOIP_GEN_MASK;
+	const qboolean local   = (genByte & IXVO_VOIP_LOCAL) ? qtrue : qfalse;
+	unsigned short seq    = (unsigned short)MSG_ReadShort(msg);
+	const int      frames = MSG_ReadByte(msg);
+	unsigned short len[IXVO_VOIP_MAX_FRAMES];
+	unsigned char  data[IXVO_VOIP_MAX_FRAMES][IXVO_VOIP_MAX_BYTES];
+	short          pcm[IXVO_VOIP_FRAME_SAMPLES];
+	vec3_t         origin = { 0, 0, 0 };
+	voipSpeaker_t  *sp;
+	int            i, error = 0;
+
+	if (frames < 1 || frames > IXVO_VOIP_MAX_FRAMES || sender < 0 || sender >= MAX_CLIENTS)
+	{
+		Com_Error(ERR_DROP, "CL_ParseVoip: bad voice message");
+	}
+	if (local)
+	{
+		origin[0] = MSG_ReadShort(msg);
+		origin[1] = MSG_ReadShort(msg);
+		origin[2] = MSG_ReadShort(msg);
+	}
+	for (i = 0; i < frames; i++)
+	{
+		len[i] = (unsigned short)(MSG_ReadShort(msg) & 0xffff);
+		if (len[i] < 1 || len[i] > IXVO_VOIP_MAX_BYTES)
+		{
+			Com_Error(ERR_DROP, "CL_ParseVoip: bad voice frame");
+		}
+		MSG_ReadData(msg, data[i], len[i]);
+	}
+
+	if (cl_voipDebug && cl_voipDebug->integer > 1)
+	{
+		Com_Printf("IXVO_NATIVE_VOIP recv slot=%d gen=%d local=%d seq=%d frames=%d muted=%d\n", sender, gen, local, seq, frames,
+		           (voipIgnore[sender >> 5] >> (sender & 31)) & 1);
+	}
+	if (!cl_voip || !cl_voip->integer || sender == clc.clientNum || (voipIgnore[sender >> 5] & (1u << (sender & 31))))
+	{
+		return;
+	}
+
+	sp = &voipSpeakers[sender];
+	if (!sp->decoder)
+	{
+		sp->decoder = opus_decoder_create(IXVO_VOIP_RATE, 1, &error);
+		if (!sp->decoder)
+		{
+			return;
+		}
+		sp->gen = -1;
+	}
+
+	VectorCopy(origin, sp->origin);
+	if (sp->gen != gen || sp->local != local || cls.realtime - sp->lastAt > 1000)
+	{
+		// a new transmission: fresh decoder state, the radio click, and 40 ms of silence so playback has a little cushion
+		static short silence[IXVO_VOIP_FRAME_SAMPLES * 2];
+		static short click[4320];
+
+		opus_decoder_ctl(sp->decoder, OPUS_RESET_STATE);
+		sp->gen       = gen;
+		sp->nextSeq   = seq;
+		sp->local     = local;
+		sp->radioOpen = !local;
+		voipRadioReset(&sp->radio);
+		if (!local && cl_voipRadio->integer)
+		{
+			const float volume = Com_Clamp(0.f, 2.f, cl_voipVolume->value);
+			const int   n      = voipRadioClick(&sp->radio, click, 1);
+
+			S_RawSamples(IXVO_VOIP_STREAM_BASE + sender, n, IXVO_VOIP_RATE, 2, 1, (const byte *)click, volume, volume);
+		}
+		Com_Memset(silence, 0, sizeof(silence));
+		if (cl_voipDebug->integer)
+		{
+			Com_Printf("IXVO_NATIVE_VOIP recv start slot=%d gen=%d\n", sender, gen);
+		}
+		S_RawSamples(IXVO_VOIP_STREAM_BASE + sender, IXVO_VOIP_FRAME_SAMPLES * 2, IXVO_VOIP_RATE, 2, 1, (const byte *)silence, 0.f, 0.f);
+	}
+	else
+	{
+		const short gap = (short)(seq - sp->nextSeq);
+
+		if (gap < 0)
+		{
+			return;  // old or duplicate
+		}
+		if (gap > 0 && gap <= 5)
+		{
+			// lost frames: conceal all but the last, and rebuild the last from this packet's FEC data
+			int k;
+
+			for (k = 0; k < gap - 1; k++)
+			{
+				const int n = opus_decode(sp->decoder, NULL, 0, pcm, IXVO_VOIP_FRAME_SAMPLES, 0);
+
+				if (n > 0)
+				{
+					CL_VoipPlay(sender, pcm, n);
+				}
+			}
+			{
+				const int n = opus_decode(sp->decoder, data[0], len[0], pcm, IXVO_VOIP_FRAME_SAMPLES, 1);
+
+				if (n > 0)
+				{
+					CL_VoipPlay(sender, pcm, n);
+				}
+			}
+		}
+	}
+
+	for (i = 0; i < frames; i++)
+	{
+		const int n = opus_decode(sp->decoder, data[i], len[i], pcm, IXVO_VOIP_FRAME_SAMPLES, 0);
+
+		if (n > 0)
+		{
+			CL_VoipPlay(sender, pcm, n);
+		}
+	}
+	sp->nextSeq   = (unsigned short)(seq + frames);
+	sp->lastAt    = cls.realtime;
+	sp->radioOpen = !local;
+}
+
+/**
+ * @brief CL_VoipCgameState answers the cgame's voice call (trap_IxvoVoice).
+ * @param[out] out out[0..1] speaking on the radio now (slots 0-31, 32-63), out[2] sending, out[3] microphone level 0..100,
+ *                 out[4] 1 voice available, 0 server without voice, -1 no microphone, out[5] cl_voip, out[6] open microphone,
+ *                 out[7..8] speaking out loud (local voice) now, out[9] own transmission is local voice
+ * @param[in] ignore ignore[0..1] players this client has muted
+ */
+void CL_VoipCgameState(int *out, const int *ignore)
+{
+	int i;
+
+	if (ignore)
+	{
+		voipIgnore[0] = (unsigned int)ignore[0];
+		voipIgnore[1] = (unsigned int)ignore[1];
+	}
+	if (!out)
+	{
+		return;
+	}
+	Com_Memset(out, 0, sizeof(int) * 10);
+	for (i = 0; i < MAX_CLIENTS; i++)
+	{
+		if (voipSpeakers[i].decoder && voipSpeakers[i].lastAt && cls.realtime - voipSpeakers[i].lastAt < 250
+		    && !(voipIgnore[i >> 5] & (1u << (i & 31))))
+		{
+			out[(voipSpeakers[i].local ? 7 : 0) + (i >> 5)] |= (int)(1u << (i & 31));
+		}
+	}
+	out[9] = voipSending && voipSendLocal;
+	out[2] = voipSending && cls.realtime - voipLastSentAt < 200;
+	out[3] = voipSending ? voipLevel : 0;
+	out[4] = !CL_VoipServerHasVoice() ? 0 : voipMicFailed ? -1 : 1;
+	out[5] = cl_voip->integer;
+	out[6] = cl_voipUseVAD->integer;
+}
