+/**
+ * @brief CL_VoipPlay hands decoded speech to the sound system.
+ */
+static void CL_VoipPlay(int sender, short *pcm, int samples)
+{
+	voipSpeaker_t *sp     = &voipSpeakers[sender];
+	float         volume  = Com_Clamp(0.f, 2.f, cl_voipVolume->value), left = volume, right = volume;
+
+	if (sp->local)
+	{
+		// spoken out loud: louder close by, gone at the edge of the range, panned to the speaker's side
+		const char *info  = cl.gameState.stringData + cl.gameState.stringOffsets[CS_SERVERINFO];
+		float      range  = (float)atof(Info_ValueForKey(info, "g_voiceLocalRange"));
+		vec3_t     eye, dir, forward, rightv, up;
+		float      dist, gain, pan;
+
+		if (range < 200.f)
+		{
+			range = 1500.f;
+		}
+		VectorCopy(cl.snap.ps.origin, eye);
+		eye[2] += cl.snap.ps.viewheight;
+		VectorSubtract(sp->origin, eye, dir);
+		dist = vec3_norm(dir);
+		gain = dist <= 250.f ? 1.f : 1.f - (dist - 250.f) / (range - 250.f);
+		gain = gain < 0.f ? 0.f : gain * gain;
+		angles_vectors(cl.snap.ps.viewangles, forward, rightv, up);
+		pan = DotProduct(dir, rightv);
+		if (dist < 32.f)
+		{
+			pan = 0.f;
+		}
+		if (DotProduct(dir, forward) < 0.f)
+		{
+			gain *= 0.85f;  // a little duller from behind
+		}
+		left  = volume * gain * (pan > 0.f ? 1.f - 0.7f * pan : 1.f);
+		right = volume * gain * (pan < 0.f ? 1.f + 0.7f * pan : 1.f);
+	}
+	else if (cl_voipRadio->integer)
+	{
+		voipRadioProcess(&sp->radio, pcm, samples, 0.006f);
+	}
+	S_RawSamples(IXVO_VOIP_STREAM_BASE + sender, samples, IXVO_VOIP_RATE, 2, 1, (const byte *)pcm, left, right);
+}
+
+/**
+ * @brief CL_VoipSpeakersFrame closes finished radio transmissions with a burst of squelch.
+ */
+static void CL_VoipSpeakersFrame(void)
+{
+	static short squelch[4320];
+	int          i, n;
+
+	for (i = 0; i < MAX_CLIENTS; i++)
+	{
+		voipSpeaker_t *sp = &voipSpeakers[i];
+
+		if (sp->radioOpen && cls.realtime - sp->lastAt > 250)
+		{
+			sp->radioOpen = qfalse;
+			if (cl_voipRadio->integer && !(voipIgnore[i >> 5] & (1u << (i & 31))))
+			{
+				const float volume = Com_Clamp(0.f, 2.f, cl_voipVolume->value);
+
+				n = voipRadioClick(&sp->radio, squelch, 0);
+				S_RawSamples(IXVO_VOIP_STREAM_BASE + i, n, IXVO_VOIP_RATE, 2, 1, (const byte *)squelch, volume, volume);
+			}
+		}
+	}
+}
