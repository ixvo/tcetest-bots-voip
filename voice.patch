+void CL_VoipCgameState(int *out, const int *ignore)
+{
+	(void)ignore;
+	if (out)
+	{
+		Com_Memset(out, 0, sizeof(int) * 10);
+	}
+}
+void CL_ParseVoip(msg_t *msg)
+{
+	int frames, i, local;
+
+	// never asked for (no cl_voip in the userinfo), but read it properly anyway
+	MSG_ReadByte(msg);
+	local = MSG_ReadByte(msg) & IXVO_VOIP_LOCAL;
+	MSG_ReadShort(msg);
+	frames = MSG_ReadByte(msg);
+	if (frames < 1 || frames > IXVO_VOIP_MAX_FRAMES)
+	{
+		Com_Error(ERR_DROP, "CL_ParseVoip: bad voice message");
+	}
+	if (local)
+	{
+		MSG_ReadShort(msg);
+		MSG_ReadShort(msg);
+		MSG_ReadShort(msg);
+	}
+	for (i = 0; i < frames; i++)
+	{
+		int  len = MSG_ReadShort(msg) & 0xffff;
+		byte skip[IXVO_VOIP_MAX_BYTES];
+
+		if (len < 1 || len > IXVO_VOIP_MAX_BYTES)
+		{
+			Com_Error(ERR_DROP, "CL_ParseVoip: bad voice frame");
+		}
+		MSG_ReadData(msg, skip, len);
+	}
+}
+
+#endif
diff --git a/etlegacy/src/client/cl_voip_radio.h b/etlegacy/src/client/cl_voip_radio.h
new file mode 100644
index 0000000000000000000000000000000000000000..36c819eac28a926fec492610c297c50e5cc0ad72
--- /dev/null
+++ b/etlegacy/src/client/cl_voip_radio.h
@@ -0,0 +1,163 @@
+/*
+ * TrueCombat: Platinum - the radio sound of team voice chat (cl_voip.c).
+ *
+ * A field radio: band-pass 350 Hz .. 3.2 kHz (two high-pass and two low-pass biquads), a
+ * presence bump at 1.8 kHz, soft clipping for a little grit and a faint hiss while the channel is
+ * open. A short click opens each transmission, and a burst of squelch closes it.
+ * Plain C, no engine dependencies, 48 kHz mono 16-bit.
+ */
+#ifndef INCLUDE_CL_VOIP_RADIO_H
+#define INCLUDE_CL_VOIP_RADIO_H
+
+#include <math.h>
+#include <string.h>
+
+#ifndef M_PI
+#define M_PI 3.14159265358979323846
+#endif
+
+typedef struct
+{
+	float b0, b1, b2, a1, a2;
+} voipBiquad_t;
+
+typedef struct
+{
+	float x1, x2, y1, y2;
+} voipBiquadState_t;
+
+typedef struct
+{
+	voipBiquadState_t s[5];
+	unsigned int noise;     ///< hiss generator state
+} voipRadio_t;
+
+static voipBiquad_t voipRadioFilters[5];
+static int          voipRadioReady;
+
+/* RBJ cookbook biquads at 48 kHz */
+static void voipBiquadPass(voipBiquad_t *f, int high, double freq, double q)
+{
+	const double w = 2.0 * M_PI * freq / 48000.0, c = cos(w), alpha = sin(w) / (2.0 * q), a0 = 1.0 + alpha;
+
+	if (high)
+	{
+		f->b0 = (float)((1.0 + c) / 2.0 / a0);
+		f->b1 = (float)(-(1.0 + c) / a0);
+	}
+	else
+	{
+		f->b0 = (float)((1.0 - c) / 2.0 / a0);
+		f->b1 = (float)((1.0 - c) / a0);
+	}
+	f->b2 = f->b0;
+	f->a1 = (float)(-2.0 * c / a0);
+	f->a2 = (float)((1.0 - alpha) / a0);
+}
+
+static void voipBiquadPeak(voipBiquad_t *f, double freq, double q, double gainDb)
+{
+	const double A = pow(10.0, gainDb / 40.0), w = 2.0 * M_PI * freq / 48000.0, c = cos(w), alpha = sin(w) / (2.0 * q);
+	const double a0 = 1.0 + alpha / A;
+
+	f->b0 = (float)((1.0 + alpha * A) / a0);
+	f->b1 = (float)(-2.0 * c / a0);
+	f->b2 = (float)((1.0 - alpha * A) / a0);
+	f->a1 = (float)(-2.0 * c / a0);
+	f->a2 = (float)((1.0 - alpha / A) / a0);
+}
+
+static void voipRadioInitFilters(void)
+{
+	voipBiquadPass(&voipRadioFilters[0], 1, 350.0, 0.707);
+	voipBiquadPass(&voipRadioFilters[1], 1, 350.0, 0.707);
+	voipBiquadPass(&voipRadioFilters[2], 0, 3200.0, 0.707);
+	voipBiquadPass(&voipRadioFilters[3], 0, 3200.0, 0.707);
+	voipBiquadPeak(&voipRadioFilters[4], 1800.0, 1.0, 5.0);
+	voipRadioReady = 1;
+}
+
+static float voipBiquadRun(const voipBiquad_t *f, voipBiquadState_t *s, float x)
+{
+	const float y = f->b0 * x + f->b1 * s->x1 + f->b2 * s->x2 - f->a1 * s->y1 - f->a2 * s->y2;
+
+	s->x2 = s->x1;
+	s->x1 = x;
+	s->y2 = s->y1;
+	s->y1 = y;
+	return y;
+}
+
+static float voipRadioHiss(voipRadio_t *r)
+{
+	r->noise = r->noise * 1664525u + 1013904223u;
+	return (float)((int)(r->noise >> 9) - (1 << 22)) / (float)(1 << 22);  // -1 .. 1
+}
+
+static void voipRadioReset(voipRadio_t *r)
+{
+	memset(r->s, 0, sizeof(r->s));
+	if (!r->noise)
+	{
+		r->noise = 0x9e3779b9u;
+	}
+}
+
+/**
+ * @brief voipRadioProcess filters speech in place.
+ * @param hiss level of the open-channel hiss, 0 .. 1 (0.006 is a faint hiss)
+ */
+static void voipRadioProcess(voipRadio_t *r, short *pcm, int samples, float hiss)
+{
+	const float drive = 2.2f, norm = 1.f / (float)tanh(2.2), pre = 0.5f;  // small signals pass at about unity gain
+	int         i, k;
+
+	if (!voipRadioReady)
+	{
+		voipRadioInitFilters();
+	}
+	for (i = 0; i < samples; i++)
+	{
+		float x = pcm[i] / 32768.f;
+
+		x += hiss * voipRadioHiss(r);
+		for (k = 0; k < 5; k++)
+		{
+			x = voipBiquadRun(&voipRadioFilters[k], &r->s[k], x);
+		}
+		x = (float)tanh(x * pre * drive) * norm * 0.9f;
+		pcm[i] = (short)(x > 1.f ? 32767 : x < -1.f ? -32768 : x * 32767.f);
+	}
+}
+
+/**
+ * @brief voipRadioClick writes the opening click (start != 0, 30 ms) or the closing squelch (start == 0, 90 ms).
+ * @return number of samples written (out must hold 4320)
+ */
+static int voipRadioClick(voipRadio_t *r, short *out, int start)
+{
+	const int samples = start ? 1440 : 4320;
+	int       i;
+
+	for (i = 0; i < samples; i++)
+	{
+		const float t = i / 48000.f;
+		float       v;
+
+		if (start)
+		{
+			// a key-up click: a sharp transient and a short 1.2 kHz chirp
+			v = (i < 48 ? 0.9f * (1.f - i / 48.f) : 0.f) + 0.35f * (float)sin(2.0 * M_PI * 1200.0 * t) * expf(-t * 120.f);
+		}
+		else
+		{
+			// squelch tail: a burst of noise that dies away
+			v = 0.45f * voipRadioHiss(r) * expf(-t * 35.f);
+		}
+		out[i] = (short)(v * 16000.f);
+	}
+	voipRadioProcess(r, out, samples, 0.f);
+	return samples;
+}
+
+#endif
