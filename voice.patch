+/* Routing adapted from TrueCombat: Platinum 0.39.7 native voice rules. */
+void IXVO_UpdateVoiceMatrix(int trapId)
+{
+    int radio[MAX_CLIENTS][2] = {{0}}, local[MAX_CLIENTS][2] = {{0}};
+    qboolean available[MAX_CLIENTS], alive[MAX_CLIENTS];
+    int i, r, s;
+    const float range = (ixvoVoiceLocalRange.integer < 200 ? 200 : ixvoVoiceLocalRange.integer);
+    const qboolean open = g_gamestate.integer != GS_PLAYING || level.intermissiontime;
+
+    for (i = 0; i < level.maxclients; ++i)
+    {
+        gclient_t *c = &level.clients[i];
+
+        available[i] = ixvoVoice.integer && c->pers.connected == CON_CONNECTED &&
+                       !(g_entities[i].r.svFlags & SVF_BOT);
+        if (!available[i]) continue;
+        alive[i] = g_entities[i].health > 0 && !(c->ps.pm_flags & PMF_LIMBO);
+
+    }
+    for (r = 0; r < level.maxclients; ++r)
+    {
+        if (!available[r]) continue;
+        for (s = 0; s < level.maxclients; ++s)
+        {
+            gclient_t *listener = &level.clients[r], *speaker = &level.clients[s];
+            qboolean sameTeam, spectators;
+            vec3_t delta;
+            unsigned int bit = 1u << (s & 31);
+            if (r == s || !available[s] || speaker->sess.muted ||
+                COM_BitCheck(listener->sess.ignoreClients, s)) continue;
+            sameTeam = listener->sess.sessionTeam == speaker->sess.sessionTeam;
+            spectators = listener->sess.sessionTeam == TEAM_SPECTATOR ||
+                         speaker->sess.sessionTeam == TEAM_SPECTATOR;
+            if (!sameTeam && !spectators && ixvoMuteEnemies[r]) continue;
+            if (open || (sameTeam && (spectators || alive[s] || !alive[r])))
+                radio[r][s >> 5] |= bit;
+            if (ixvoVoiceLocal.integer && !spectators && alive[s])
+            {
+                VectorSubtract(listener->ps.origin, speaker->ps.origin, delta);
+                if (DotProduct(delta, delta) <= range * range)
+                    local[r][s >> 5] |= bit;
+            }
+        }
+    }
+    IXVO_SetVoiceMatrix(trapId, radio[0], ixvoVoice.integer ? level.maxclients : 0, local[0]);
+}
