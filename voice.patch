diff --git a/etlegacy/src/client/cl_voip.c b/etlegacy/src/client/cl_voip.c
new file mode 100644
index 0000000000000000000000000000000000000000..f0a1533711cb169db195df322a627b353423dd38
--- /dev/null
+++ b/etlegacy/src/client/cl_voip.c
@@ -0,0 +1,1070 @@
+/*
+ * TrueCombat: Platinum - native voice chat, client side.
+ *
+ * Microphone: SDL2 audio capture at 48 kHz mono, independent of the sound backend.
+ * Codec:      Opus, 20 ms frames at about 24 kbps, with in-band FEC for lost packets.
+ * Network:    clc_voipOpus / svc_voipOpus inside the normal game packets (qcommon/ixvo_voip.h).
+ * Playback:   one raw sound stream per speaker (stream IXVO_VOIP_STREAM_BASE + slot).
+ *
+ * Two channels, like Squad:
+ *   radio (+voip)       team voice through a field-radio filter, with a click when a transmission
+ *                       opens and squelch when it closes (cl_voip_radio.h)
+ *   local (+voiplocal)  spoken out loud: everyone within range hears it, enemies too, panned and
+ *                       fading with distance from where the speaker stands
+ *
+ * Cvars (archived):
+ *   cl_voip 1                voice on (userinfo; 0 = never send or play voice)
+ *   cl_voipVolume 1          voice playback volume (0 .. 2)
+ *   cl_voipMicGain 1         microphone gain (0.25 .. 4)
+ *   cl_voipUseVAD 0          1 = open microphone: send whenever you speak (no key needed)
+ *   cl_voipVADThreshold 0.02 open microphone level (frame rms, 0 .. 1; 0.39.1: was 0.08, which real
+ *                            microphones never reach, so voice activation never sent anything)
+ *   cl_voipCaptureDevice ""  microphone name ("" = system default); voip_devices lists them,
+ *                            voip_nextDevice steps through them (Options > Voice)
+ *   cl_voipRadio 1           radio sound on team voice (0 = clean)
+ *   cl_voipMuteEnemies 0     1 = never hear the other team, not even in warmup (userinfo)
+ * Test aids (not archived): cl_voipTestTone 1 sends a 440 Hz tone instead of the microphone,
+ *   cl_voipDebug 1 prints every transmission start and received frame counts (IXVO_NATIVE_VOIP lines).
+ * Read-only, for Options > Voice (0.39.1): ui_voipDevice (the microphone in use, readable name),
+ *   cl_voipMeter (live microphone level bar while the microphone runs, or why it is silent).
+ * Commands: +voip / -voip (team radio), +voiplocal / -voiplocal (local voice), voip_devices, voip_nextDevice.
+ * The push-to-talk keys always transmit, also with voice activation on (0.39.1).
+ * Muting single players goes through the game's mute list (mute / unmute / mute menu).
+ *
+ * Without IXVO_VOIP (no libopus in the build) everything here is a no-op and the client never
+ * says it can play voice.
+ */
+
+#include "client.h"
+#include "../qcommon/ixvo_voip.h"
+
+#ifdef IXVO_VOIP
+
+#include <SDL2/SDL.h>
+#include "opus.h"
+#include "cl_voip_radio.h"
+
+static cvar_t *cl_voip;
+static cvar_t *cl_voipVolume;
+static cvar_t *cl_voipMicGain;
+static cvar_t *cl_voipUseVAD;
+static cvar_t *cl_voipVADThreshold;
+static cvar_t *cl_voipCaptureDevice;
+static cvar_t *cl_voipRadio;
+static cvar_t *cl_voipTestTone;
+static cvar_t *cl_voipDebug;
+static cvar_t *cl_voipMicTest;                   ///< 0.36.0: hear your own microphone (Options > Voice)
+static cvar_t *cl_voipMeter;                     ///< 0.39.1: live level bar for Options > Voice (read-only)
+static cvar_t *ui_voipDevice;                    ///< 0.39.1: microphone name for Options > Voice (read-only)
+static int    voipMeterAt;                       ///< realtime of the last meter update
+static int    voipMeterLevel;                    ///< loudest level since the last meter update, 0..100
+static int    voipMeterHeardAt;                  ///< realtime of the last captured frame
+static int    voipSilentFrames;                  ///< captured frames in a row that were pure digital silence
+static qboolean voipSilentWarned;
+static voipRadio_t voipTestRadio;
+static qboolean    voipTestWasOn;
+static int    voipToneAt;                        ///< test tone: realtime covered so far
+static int    voipTonePhase;
+
+/* ---------------------------------------------------------------- sending */
+static SDL_AudioDeviceID voipMic;
+static qboolean          voipMicFailed;          ///< opening the microphone failed; retried when the device cvar changes
+static OpusEncoder       *voipEncoder;
+static qboolean          voipKeyDown;            ///< push-to-talk held (radio)
+static qboolean          voipLocalKeyDown;       ///< local voice key held
+static qboolean          voipSendLocal;          ///< the current transmission is local voice
+static qboolean          voipSending;            ///< currently transmitting
+static int               voipReleaseAt;          ///< when push-to-talk was let go (a short tail is still sent)
+static int               voipLastVoiceAt;        ///< open microphone: last frame above the threshold
+static unsigned char     voipGen;
+static unsigned short    voipSeq;
+static int               voipLevel;              ///< microphone level 0..100, for the HUD
+static int               voipLastSentAt;
+
+static int            voipOutFrames;
+static unsigned short voipOutSeq;
+static unsigned short voipOutLen[IXVO_VOIP_MAX_FRAMES];
+static unsigned char  voipOut[IXVO_VOIP_MAX_FRAMES][IXVO_VOIP_MAX_BYTES];
+
+/* ---------------------------------------------------------------- receiving */
+typedef struct
+{
+	OpusDecoder *decoder;
+	int gen;                                    ///< -1 = no stream yet
+	unsigned short nextSeq;
+	int lastAt;                                 ///< cls.realtime of the last frame
+	qboolean local;                             ///< the current transmission is local voice
+	qboolean radioOpen;                         ///< a radio transmission is playing (squelch when it ends)
+	vec3_t origin;                              ///< local voice: where the speaker stands
+	voipRadio_t radio;                          ///< radio filter state
+} voipSpeaker_t;
+
+static voipSpeaker_t voipSpeakers[MAX_CLIENTS];
+static void          CL_VoipSpeakersFrame(void);
+static unsigned int  voipIgnore[2];             ///< muted players (set by cgame)
+
+/**
+ * @brief CL_VoipServerHasVoice
+ * @return qtrue when the server advertises voice (serverinfo sv_voice 1)
+ */
+static qboolean CL_VoipServerHasVoice(void)
+{
+	const char *info;
+
+	if (!cl.gameState.stringOffsets[CS_SERVERINFO])
+	{
+		return qfalse;
+	}
+	info = cl.gameState.stringData + cl.gameState.stringOffsets[CS_SERVERINFO];
+	return !strcmp(Info_ValueForKey(info, "ixvo_voice_api"), "1") && atoi(Info_ValueForKey(info, "sv_voice")) > 0 ? qtrue : qfalse;
+}
+
+/**
+ * @brief CL_VoipActive
+ * @return qtrue when this client may send voice right now
+ */
+static qboolean CL_VoipActive(void)
+{
+	return cl_voip && cl_voip->integer && cls.state == CA_ACTIVE && !clc.demo.playing && CL_VoipServerHasVoice();
+}
+
+/**
+ * @brief CL_VoipCloseMic
+ */
+static void CL_VoipCloseMic(void)
+{
+	if (voipMic)
+	{
+		SDL_CloseAudioDevice(voipMic);
+		voipMic = 0;
+	}
+}
+
+/**
+ * @brief CL_VoipOpenMic opens the microphone (paused) the first time it is needed.
+ */
+static qboolean CL_VoipOpenMic(void)
+{
+	SDL_AudioSpec want, have;
+	const char    *device;
+
+	if (voipMic)
+	{
+		return qtrue;
+	}
+	if (voipMicFailed)
+	{
+		return qfalse;
+	}
+	if (!SDL_WasInit(SDL_INIT_AUDIO) && SDL_InitSubSystem(SDL_INIT_AUDIO) != 0)
+	{
+		Com_Printf(S_COLOR_YELLOW "Voice chat: audio init failed: %s\n", SDL_GetError());
+		voipMicFailed = qtrue;
+		return qfalse;
+	}
+	Com_Memset(&want, 0, sizeof(want));
+	want.freq     = IXVO_VOIP_RATE;
+	want.format   = AUDIO_S16SYS;
+	want.channels = 1;
+	want.samples  = IXVO_VOIP_FRAME_SAMPLES / 2;
+	device        = cl_voipCaptureDevice->string[0] ? cl_voipCaptureDevice->string : NULL;
+	voipMic       = SDL_OpenAudioDevice(device, 1, &want, &have, 0); // SDL converts to the format we ask for
+	if (!voipMic && device)
+	{
+		Com_Printf(S_COLOR_YELLOW "Voice chat: microphone \"%s\" not found, using the default.\n", device);
+		voipMic = SDL_OpenAudioDevice(NULL, 1, &want, &have, 0);
+	}
+	if (!voipMic)
+	{
+		Com_Printf(S_COLOR_YELLOW "Voice chat: no microphone (%s). Check your capture device and microphone permissions.\n", SDL_GetError());
+		voipMicFailed = qtrue;
+		return qfalse;
+	}
+	Com_Printf("Voice chat: microphone ready (%s).\n", device ? device : "system default");
+	voipSilentFrames = 0;
+	voipSilentWarned = qfalse;
+	return qtrue;
+}
+
+/**
+ * @brief CL_VoipStartSending
+ */
+static void CL_VoipStartSending(void)
+{
+	int error = 0;
+
+	if (voipSending || (!cl_voipTestTone->integer && !CL_VoipOpenMic()))
+	{
+		return;
+	}
+	if (!voipEncoder)
+	{
+		voipEncoder = opus_encoder_create(IXVO_VOIP_RATE, 1, OPUS_APPLICATION_VOIP, &error);
+		if (!voipEncoder)
+		{
+			Com_Printf(S_COLOR_YELLOW "Voice chat: Opus encoder failed (%d).\n", error);
+			return;
+		}
+		opus_encoder_ctl(voipEncoder, OPUS_SET_BITRATE(24000));
+		opus_encoder_ctl(voipEncoder, OPUS_SET_COMPLEXITY(5));
+		opus_encoder_ctl(voipEncoder, OPUS_SET_INBAND_FEC(1));
+		opus_encoder_ctl(voipEncoder, OPUS_SET_PACKET_LOSS_PERC(10));
+		opus_encoder_ctl(voipEncoder, OPUS_SET_SIGNAL(OPUS_SIGNAL_VOICE));
+	}
+	else
+	{
+		opus_encoder_ctl(voipEncoder, OPUS_RESET_STATE);
+	}
+	if (cl_voipTestTone->integer)
+	{
+		voipToneAt = cls.realtime;
+	}
+	else
+	{
+		if (!cl_voipUseVAD->integer)
+		{
+			SDL_ClearQueuedAudio(voipMic);
+		}
+		SDL_PauseAudioDevice(voipMic, 0);
+	}
+	voipGen       = (unsigned char)((voipGen + 1) & IXVO_VOIP_GEN_MASK);
+	voipSendLocal = voipLocalKeyDown && !voipKeyDown;
+	if (cl_voipDebug->integer)
+	{
+		Com_Printf("IXVO_NATIVE_VOIP send start gen=%d local=%d tone=%d\n", voipGen, voipSendLocal, cl_voipTestTone->integer);
+	}
+	voipSending   = qtrue;
+	voipOutFrames = 0;
+}
+
+/**
+ * @brief CL_VoipStopSending
+ */
+static void CL_VoipStopSending(void)
+{
+	if (voipMic && !cl_voipUseVAD->integer)
+	{
+		SDL_PauseAudioDevice(voipMic, 1);
+		SDL_ClearQueuedAudio(voipMic);
+	}
+	voipSending = qfalse;
+	voipLevel   = 0;
+}
+
+/**
+ * @brief CL_VoipGain applies the microphone gain and measures the level.
+ * @return the frame's rms level, 0..1
+ */
+static float CL_VoipGain(short *pcm)
+{
+	const float gain = Com_Clamp(0.25f, 4.f, cl_voipMicGain->value);
+	double      sum  = 0;
+	float       rms;
+	int         i, peak = 0;
+
+	for (i = 0; i < IXVO_VOIP_FRAME_SAMPLES; i++)
+	{
+		int v = (int)(pcm[i] * gain);
+
+		v      = v > 32767 ? 32767 : v < -32768 ? -32768 : v;
+		pcm[i] = (short)v;
+		sum   += (double)v * v;
+		if (v > peak || -v > peak)
+		{
+			peak = v < 0 ? -v : v;
+		}
+	}
+	rms = (float)sqrt(sum / IXVO_VOIP_FRAME_SAMPLES) / 32768.f;
+	// 0.39.1: level on a decibel scale, -60 dBFS .. 0 dBFS = 0 .. 100 (real speech sits around -40 .. -15 dBFS)
+	voipLevel = rms > 0.001f ? (int)((20.f * log10f(rms) + 60.f) * (100.f / 60.f)) : 0;
+	voipLevel = voipLevel < 0 ? 0 : voipLevel > 100 ? 100 : voipLevel;
+	if (voipLevel > voipMeterLevel)
+	{
+		voipMeterLevel = voipLevel;
+	}
+	voipMeterHeardAt = cls.realtime;
+	// Windows hands out pure digital silence when desktop apps may not use the microphone
+	voipSilentFrames = peak ? 0 : voipSilentFrames + 1;
+	if (voipSilentFrames >= 150 && !voipSilentWarned)
+	{
+		voipSilentWarned = qtrue;
+		Com_Printf(S_COLOR_YELLOW "Voice chat: the microphone sends only silence. Check that it is not muted, select it with cl_voipCaptureDevice, "
+		           "and allow desktop apps under Windows Settings > Privacy > Microphone.\n");
+	}
+	return rms;
+}
+
+/**
+ * @brief CL_VoipEncodeFrame encodes one frame (gain already applied) into the outgoing queue.
+ */
+static void CL_VoipEncodeFrame(const short *pcm)
+{
+	unsigned char packet[IXVO_VOIP_MAX_BYTES];
+	const int     len = opus_encode(voipEncoder, pcm, IXVO_VOIP_FRAME_SAMPLES, packet, sizeof(packet));
+
+	if (len > 0)
+	{
+		if (voipOutFrames == IXVO_VOIP_MAX_FRAMES)
+		{
+			// the game is not sending packets fast enough: drop the oldest frame
+			memmove(voipOut[0], voipOut[1], sizeof(voipOut[0]) * (IXVO_VOIP_MAX_FRAMES - 1));
+			memmove(voipOutLen, voipOutLen + 1, sizeof(voipOutLen[0]) * (IXVO_VOIP_MAX_FRAMES - 1));
+			voipOutFrames--;
+			voipOutSeq++;
+		}
+		if (!voipOutFrames)
+		{
+			voipOutSeq = voipSeq;
+		}
+		Com_Memcpy(voipOut[voipOutFrames], packet, len);
+		voipOutLen[voipOutFrames] = (unsigned short)len;
+		voipOutFrames++;
+		voipLastSentAt = cls.realtime;
+	}
+	voipSeq++;
+}
+
+/**
+ * @brief CL_VoipUpdateMeter refreshes cl_voipMeter (Options > Voice) about ten times a second.
+ * The bar is the loudest frame since the last update on the decibel scale of CL_VoipGain;
+ * '|' marks the voice activation level.
+ */
+static void CL_VoipUpdateMeter(void)
+{
+	char text[64];
+	int  i, mark, fill;
+	float thr;
+
+	if (cls.realtime - voipMeterAt < 100 && cls.realtime >= voipMeterAt)
+	{
+		return;
+	}
+	voipMeterAt = cls.realtime;
+	if (voipMicFailed)
+	{
+		Q_strncpyz(text, "No microphone found", sizeof(text));
+	}
+	else if (!voipMic || cls.realtime - voipMeterHeardAt > 500)
+	{
+		Q_strncpyz(text, cl_voipMicTest->integer ? "Waiting for the microphone..." : "Microphone idle: start the mic test", sizeof(text));
+	}
+	else if (voipSilentFrames >= 150)
+	{
+		Q_strncpyz(text, "Silence only: muted or capture unavailable", sizeof(text));
+	}
+	else
+	{
+		thr  = Com_Clamp(0.001f, 1.f, cl_voipVADThreshold->value);
+		mark = (int)((20.f * log10f(thr) + 60.f) * (24.f / 60.f));
+		mark = mark < 0 ? 0 : mark > 23 ? 23 : mark;
+		fill = (voipMeterLevel * 24 + 50) / 100;
+		text[0] = '[';
+		for (i = 0; i < 24; i++)
+		{
+			text[1 + i] = (cl_voipUseVAD->integer && i == mark) ? '|' : i < fill ? '#' : '.';
+		}
+		Com_sprintf(text + 25, sizeof(text) - 25, "] %d%%%s", voipMeterLevel,
+		            cl_voipUseVAD->integer ? (voipMeterLevel > mark * 100 / 24 ? "  sending" : "") : "");
+	}
+	voipMeterLevel = 0;
+	if (strcmp(cl_voipMeter->string, text))
+	{
+		Cvar_Set("cl_voipMeter", text);
+	}
+}
+
+/**
+ * @brief CL_VoipDeviceLabel keeps ui_voipDevice (the microphone shown in Options > Voice) in step.
+ */
+static void CL_VoipDeviceLabel(void)
+{
+	Cvar_Set("ui_voipDevice", cl_voipCaptureDevice->string[0] ? cl_voipCaptureDevice->string : "System default microphone");
+}
+
+/**
+ * @brief CL_VoipFrame runs the microphone. Called every client frame before CL_SendCmd.
+ */
+void CL_VoipFrame(void)
+{
+	short    pcm[IXVO_VOIP_FRAME_SAMPLES];
+	qboolean want;
+
+	if (!cl_voip)
+	{
+		return;
+	}
+	CL_VoipSpeakersFrame();
+	CL_VoipUpdateMeter();
+	if (cl_voipCaptureDevice->modified)
+	{
+		cl_voipCaptureDevice->modified = qfalse;
+		CL_VoipStopSending();
+		CL_VoipCloseMic();
+		CL_VoipDeviceLabel();
+		voipMicFailed = qfalse;
+	}
+	// 0.36.0 microphone test: play the microphone back to this player only; nothing is sent
+	if (cl_voipMicTest->integer)
+	{
+		const float volume = Com_Clamp(0.f, 2.f, cl_voipVolume->value);
+
+		if (voipSending)
+		{
+			CL_VoipStopSending();
+		}
+		if (!voipTestWasOn)
+		{
+			voipRadioReset(&voipTestRadio);
+			voipTestWasOn = qtrue;
+		}
+		if (!CL_VoipOpenMic())
+		{
+			return;
+		}
+		SDL_PauseAudioDevice(voipMic, 0);
+		while (SDL_GetQueuedAudioSize(voipMic) >= sizeof(pcm))
+		{
+			SDL_DequeueAudio(voipMic, pcm, sizeof(pcm));
+			CL_VoipGain(pcm);
+			if (cl_voipRadio->integer)
+			{
+				voipRadioProcess(&voipTestRadio, pcm, IXVO_VOIP_FRAME_SAMPLES, 0.006f);
+			}
+			S_RawSamples(IXVO_VOIP_STREAM_BASE - 1, IXVO_VOIP_FRAME_SAMPLES, IXVO_VOIP_RATE, 2, 1, (const byte *)pcm, volume, volume);
+		}
+		return;
+	}
+	if (voipTestWasOn)
+	{
+		voipTestWasOn = qfalse;
+		voipLevel     = 0;
+		if (voipMic && !cl_voipUseVAD->integer)
+		{
+			SDL_PauseAudioDevice(voipMic, 1);
+			SDL_ClearQueuedAudio(voipMic);
+		}
+	}
+	if (!CL_VoipActive())
+	{
+		if (voipSending)
+		{
+			CL_VoipStopSending();
+		}
+		if (voipMic && cl_voipUseVAD->integer)
+		{
+			SDL_PauseAudioDevice(voipMic, 1);
+		}
+		return;
+	}
+
+	if (cl_voipUseVAD->integer)
+	{
+		// open microphone: keep capturing, transmit while the level is above the threshold
+		// 0.39.1: a held push-to-talk key always transmits (radio, or local voice for its own key)
+		const qboolean held = voipKeyDown || voipLocalKeyDown;
+
+		if (!CL_VoipOpenMic())
+		{
+			return;
+		}
+		SDL_PauseAudioDevice(voipMic, 0);
+		if (voipSending && held && voipSendLocal != (voipLocalKeyDown && !voipKeyDown))
+		{
+			CL_VoipStopSending();  // switched between radio and local voice: start a new transmission
+		}
+		while (SDL_GetQueuedAudioSize(voipMic) >= sizeof(pcm))
+		{
+			qboolean loud;
+
+			SDL_DequeueAudio(voipMic, pcm, sizeof(pcm));
+			loud = (CL_VoipGain(pcm) >= cl_voipVADThreshold->value || held) ? qtrue : qfalse;
+			if (!voipSending)
+			{
+				if (!loud)
+				{
+					continue;
+				}
+				CL_VoipStartSending();
+				if (!voipSending)
+				{
+					return;
+				}
+				voipLastVoiceAt = cls.realtime;
+			}
+			CL_VoipEncodeFrame(pcm);
+			if (loud)
+			{
+				voipLastVoiceAt = cls.realtime;
+			}
+			else if (cls.realtime - voipLastVoiceAt > 400)
+			{
+				voipSending = qfalse;  // hang time over; the microphone keeps listening
+				voipLevel   = 0;
+			}
+		}
+		return;
+	}
+
+	// push to talk; keep sending 150 ms after the key comes up so the last word isn't cut off
+	want = voipKeyDown || voipLocalKeyDown || (voipSending && cls.realtime - voipReleaseAt < 150);
+	if (want && voipSending && (voipKeyDown || voipLocalKeyDown) && voipSendLocal != (voipLocalKeyDown && !voipKeyDown))
+	{
+		CL_VoipStopSending();   // switched between radio and local voice: start a new transmission
+	}
+	if (want && !voipSending)
+	{
+		CL_VoipStartSending();
+	}
+	else if (!want && voipSending)
+	{
+		CL_VoipStopSending();
+	}
+	if (!voipSending)
+	{
+		return;
+	}
+	if (cl_voipTestTone->integer)
+	{
+		int i;
+
+		if (cls.realtime - voipToneAt > 200)
+		{
+			voipToneAt = cls.realtime - 200;  // after a hitch, don't burst
+		}
+		while (cls.realtime - voipToneAt >= 20)
+		{
+			for (i = 0; i < IXVO_VOIP_FRAME_SAMPLES; i++, voipTonePhase++)
+			{
+				pcm[i] = (short)(6000.0 * sin(voipTonePhase * (2.0 * M_PI * 440.0 / IXVO_VOIP_RATE)));
+			}
+			voipTonePhase %= IXVO_VOIP_RATE;
+			voipToneAt    += 20;
+			CL_VoipGain(pcm);
+			CL_VoipEncodeFrame(pcm);
+		}
+		return;
+	}
+	while (SDL_GetQueuedAudioSize(voipMic) >= sizeof(pcm))
+	{
+		SDL_DequeueAudio(voipMic, pcm, sizeof(pcm));
+		CL_VoipGain(pcm);
+		CL_VoipEncodeFrame(pcm);
+	}
+}
+
+/**
+ * @brief CL_WriteVoip adds the waiting voice frames to an outgoing packet (CL_WritePacket).
+ */
+void CL_WriteVoip(msg_t *buf)
+{
+	int i;
+
+	if (!voipOutFrames)
+	{
+		return;
+	}
+	if (!CL_VoipActive())
+	{
+		voipOutFrames = 0;
+		return;
+	}
+	MSG_WriteByte(buf, clc_voipOpus);
+	MSG_WriteByte(buf, voipGen | (voipSendLocal ? IXVO_VOIP_LOCAL : 0));
+	MSG_WriteShort(buf, voipOutSeq);
+	MSG_WriteByte(buf, voipOutFrames);
+	for (i = 0; i < voipOutFrames; i++)
+	{
+		MSG_WriteShort(buf, voipOutLen[i]);
+		MSG_WriteData(buf, voipOut[i], voipOutLen[i]);
+	}
+	voipOutFrames = 0;
+}
