+/**
+ * @brief CL_VoipDevices_f lists the microphones SDL can see.
+ */
+static void CL_VoipDevices_f(void)
+{
+	int i, count;
+
+	if (!SDL_WasInit(SDL_INIT_AUDIO) && SDL_InitSubSystem(SDL_INIT_AUDIO) != 0)
+	{
+		Com_Printf("No audio: %s\n", SDL_GetError());
+		return;
+	}
+	count = SDL_GetNumAudioDevices(1);
+	Com_Printf("Microphones (set cl_voipCaptureDevice to one of these, or \"\" for the default):\n");
+	for (i = 0; i < count; i++)
+	{
+		Com_Printf("  \"%s\"\n", SDL_GetAudioDeviceName(i, 1));
+	}
+	if (count <= 0)
+	{
+		Com_Printf("  none found\n");
+	}
+}
+
+/**
+ * @brief CL_VoipNextDevice_f picks the next microphone SDL can see (after the last one: the Windows default).
+ * Options > Voice: NEXT MICROPHONE; "voip_nextDevice default" (WINDOWS DEFAULT) goes back to the default.
+ * The microphone reopens on its next use.
+ */
+static void CL_VoipNextDevice_f(void)
+{
+	const char *current = cl_voipCaptureDevice->string;
+	const char *next    = "";
+	int        i, count, at = -1;
+
+	if (!SDL_WasInit(SDL_INIT_AUDIO) && SDL_InitSubSystem(SDL_INIT_AUDIO) != 0)
+	{
+		Com_Printf("No audio: %s\n", SDL_GetError());
+		return;
+	}
+	if (Cmd_Argc() > 1 && !Q_stricmp(Cmd_Argv(1), "default"))
+	{
+		current = "";
+		count   = 0;          // "voip_nextDevice default": back to the System default microphone
+	}
+	else
+	{
+		count = SDL_GetNumAudioDevices(1);
+	}
+	for (i = 0; i < count && current[0]; i++)
+	{
+		const char *name = SDL_GetAudioDeviceName(i, 1);
+
+		if (name && !Q_stricmp(name, current))
+		{
+			at = i;
+			break;
+		}
+	}
+	if (current[0] && at < 0)
+	{
+		at = count;           // the saved microphone is gone: go back to the default
+	}
+	if (at + 1 < count)
+	{
+		const char *name = SDL_GetAudioDeviceName(at + 1, 1);
+
+		next = name ? name : "";
+	}
+	Cvar_Set("cl_voipCaptureDevice", next);
+	CL_VoipDeviceLabel();
+	Com_Printf("Microphone: %s\n", ui_voipDevice->string);
+}
+
+/**
+ * @brief CL_VoipReset forgets all speakers (disconnect, map change).
+ */
+void CL_VoipReset(void)
+{
+	int i;
+
+	CL_VoipStopSending();
+	voipOutFrames = 0;
+	for (i = 0; i < MAX_CLIENTS; i++)
+	{
+		voipSpeakers[i].gen       = -1;
+		voipSpeakers[i].lastAt    = 0;
+		voipSpeakers[i].radioOpen = qfalse;
+	}
+	voipIgnore[0] = voipIgnore[1] = 0;
+}
