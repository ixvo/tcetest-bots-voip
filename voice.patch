+
+/* ET: Legacy extension discovery. Classic ET has no query trap. */
+static int ixvoVoiceMatrixTrap;
+void IXVO_InitVoiceMatrix(void)
+{
+    char value[16];
+    ixvoVoiceMatrixTrap = 0;
+    if (trap_Cvar_VariableIntegerValue("//trap_GetValue") > 0 &&
+        TCE_SYSCALL_3(trap_Cvar_VariableIntegerValue("//trap_GetValue"), value, sizeof(value), "trap_IxvoVoiceMatrix"))
+        ixvoVoiceMatrixTrap = atoi(value);
+}
+void IXVO_SendVoiceMatrix(void)
+{
+    if (ixvoVoiceMatrixTrap)
+        IXVO_UpdateVoiceMatrix(ixvoVoiceMatrixTrap);
+}
+void IXVO_SetVoiceMatrix(int trapId, int *radio, int count, int *local)
+{
+    TCE_SYSCALL_3(trapId, radio, count, local);
+}
