+/**
+ * @brief CL_VoipShutdown
+ */
+void CL_VoipShutdown(void)
+{
+	int i;
+
+	CL_VoipStopSending();
+	CL_VoipCloseMic();
+	if (voipEncoder)
+	{
+		opus_encoder_destroy(voipEncoder);
+		voipEncoder = NULL;
+	}
+	for (i = 0; i < MAX_CLIENTS; i++)
+	{
+		if (voipSpeakers[i].decoder)
+		{
+			opus_decoder_destroy(voipSpeakers[i].decoder);
+			voipSpeakers[i].decoder = NULL;
+		}
+	}
+	Cmd_RemoveCommand("+voip");
+	Cmd_RemoveCommand("-voip");
+	Cmd_RemoveCommand("+voiplocal");
+	Cmd_RemoveCommand("-voiplocal");
+	Cmd_RemoveCommand("voip_devices");
+	Cmd_RemoveCommand("voip_nextDevice");
+}
