+void IXVO_InitBots(int seed)
+{
+	fileHandle_t file = 0;
+	int length, loaded = 0;
+	char *data;
+	nextName = 0;
+	memset(lastVisit, 0, sizeof(lastVisit));
+	memset(reservedUntil, 0, sizeof(reservedUntil));
+	nextFill = level.time + 1000;
+	memset(roster, 0, sizeof(roster));
+	memset(vacancies, 0, sizeof(vacancies));
+	botChat.loaded = 0;
+	botChatRoundReset();
+	botChat.seed = (unsigned)seed;
+	length = trap_FS_FOpenFile("bots/ixvo_phrases.txt", &file, FS_READ);
+	if (file)
+	{
+		if (length > 0 && length < 1024 * 1024 && (data = malloc((size_t)length + 1)) != NULL)
+		{
+			trap_FS_Read(data, length, file);
+			data[length] = 0;
+			loaded = botChatLoad(data, length);
+			free(data);
+		}
+		trap_FS_FCloseFile(file);
+	}
+	G_Printf("IXVO bots: %d chat phrases loaded\n", loaded > 0 ? loaded : 0);
+}
+
+static int AddBot(int skill, char *team, const char *name, qboolean fill, const ixvoVacancy_t *vacancy)
+{
+	char info[MAX_INFO_STRING] = "", generated[MAX_NAME_LENGTH];
+	const char *reason;
+	gentity_t *ent;
+	int slot = trap_BotAllocateClient(0);
+	if (slot < 0)
+	{
+		G_Printf("IXVO: no free bot slot\n");
+		return -1;
+	}
+	if (!name || !*name)
+	{
+		const int count = sizeof(names) / sizeof(names[0]);
+		Com_sprintf(generated, sizeof(generated), "%s%d", names[nextName % count], nextName / count + 1);
+		name = generated;
+		nextName++;
+	}
+	if (!Q_stricmp(team, "auto"))
+		team = PickTeam(slot) == TEAM_AXIS ? "red" : "blue";
+	Info_SetValueForKey(info, "name", name);
+	Info_SetValueForKey(info, "ixvo_bot", "1");
+	Info_SetValueForKey(info, "ixvo_fill", fill ? "1" : "0");
+	Info_SetValueForKey(info, "skill", va("%d", ClampSkill(skill)));
+	Info_SetValueForKey(info, "team", team);
+	Info_SetValueForKey(info, "rate", "25000");
+	Info_SetValueForKey(info, "snaps", "20");
+	trap_SetUserinfo(slot, info);
+	reason = ClientConnect(slot, qtrue, qtrue);
+	if (reason)
+	{
+		G_Printf("IXVO: bot rejected: %s\n", reason);
+		IXVO_ForgetBot(slot);
+		trap_BotFreeClient(slot);
+		return -1;
+	}
+	ent = &g_entities[slot];
+	if (vacancy)
+	{
+		int seconds = ixvo_botStandinTime.integer;
+		seconds = seconds < 1 ? 1 : seconds > 3600 ? 3600 : seconds;
+		roster[slot].standinUntil = level.time + seconds * 1000;
+		Q_strncpyz(roster[slot].ownerGuid, vacancy->guid, sizeof(roster[slot].ownerGuid));
+		ent->client->sess.latchPlayerType = vacancy->playerClass;
+		ent->client->sess.latchPlayerWeapon = vacancy->primary;
+		ent->client->sess.latchPlayerWeapon2 = vacancy->secondary;
+		ent->client->sess.latchPlayerWeapon3 = vacancy->utility;
+	}
+	/* Force a genuine team transition, which also runs TCE2's ClientBegin. */
+	ent->client->sess.sessionTeam = TEAM_SPECTATOR;
+	if (!SetTeam(ent, team, qtrue, -1, -1, -1, qfalse))
+	{
+		trap_DropClient(slot, "Could not join a team", 0);
+		return -1;
+	}
+	G_Printf("IXVO: added %s (slot %d, skill %d, %s)\n", ent->client->pers.netname, slot, roster[slot].skill, team);
+	return slot;
+}
+
+qboolean IXVO_BotCommand(const char *cmd)
+{
+	char skill[8], team[16], name[MAX_NAME_LENGTH];
+	int i;
+	if (Q_stricmp(cmd, "ixvo_addbot") && Q_stricmp(cmd, "ixvo_kickbot") && Q_stricmp(cmd, "ixvo_botstatus"))
+		return qfalse;
+	if (!IXVO_BotsEnabled())
+	{
+		G_Printf("Set ixvo_bots 1, omnibot_enable 0 and restart the map.\n");
+		return qtrue;
+	}
+	if (!Q_stricmp(cmd, "ixvo_addbot"))
+	{
+		trap_Argv(1, skill, sizeof(skill));
+		trap_Argv(2, team, sizeof(team));
+		trap_Argv(3, name, sizeof(name));
+		if (!*team) Q_strncpyz(team, "auto", sizeof(team));
+		if (trap_Argc() > 4 || (*skill && (strlen(skill) != 1 || *skill < '1' || *skill > '5')) ||
+		    (Q_stricmp(team, "auto") && Q_stricmp(team, "red") && Q_stricmp(team, "blue")))
+			G_Printf("ixvo_addbot [1-5] [auto|red|blue] [name]\n");
+		else AddBot(*skill ? atoi(skill) : 3, team, name, qfalse, NULL);
+		return qtrue;
+	}
+	trap_Argv(1, name, sizeof(name));
+	for (i = 0; i < level.maxclients; ++i)
+	{
+		if (!IXVO_IsBot(i)) continue;
+		if (!Q_stricmp(cmd, "ixvo_botstatus"))
+			G_Printf("IXVO slot %d: %s, team %d, skill %d, health %d, origin %.0f %.0f %.0f, patrols %d, last patrol node %d\n", i,
+			         level.clients[i].pers.netname, level.clients[i].sess.sessionTeam, roster[i].skill,
+			         g_entities[i].health, level.clients[i].ps.origin[0], level.clients[i].ps.origin[1], level.clients[i].ps.origin[2],
+			         roster[i].patrolCount, roster[i].patrolGoal);
+		else if (!Q_stricmp(name, "all") || !Q_stricmp(name, va("%d", i)) || !Q_stricmp(name, level.clients[i].pers.netname))
+			trap_DropClient(i, "Bot removed", 0);
+	}
+	return qtrue;
+}
+
+void IXVO_BotTeamJoined(gentity_t *ent)
+{
+	int i, release = -1;
+	char info[MAX_INFO_STRING], guid[40];
+	int team = ent->client->sess.sessionTeam;
+	if (!IXVO_BotsEnabled() || !ixvo_botStandin.integer || ent->r.svFlags & SVF_BOT ||
+	    (team != TEAM_AXIS && team != TEAM_ALLIES)) return;
+	trap_GetUserinfo(ent->s.number, info, sizeof(info));
+	Q_strncpyz(guid, Info_ValueForKey(info, "cl_guid"), sizeof(guid));
+	for (i = 0; i < level.maxclients; ++i)
+	{
+		if (vacancies[i].team && (vacancies[i].team == team || (*guid && !Q_stricmp(guid, vacancies[i].guid))))
+		{
+			memset(&vacancies[i], 0, sizeof(vacancies[i]));
+			return;
+		}
+		if (!roster[i].standinUntil) continue;
+		if (*guid && !Q_stricmp(guid, roster[i].ownerGuid)) { release = i; break; }
+		if (release < 0 && level.clients[i].sess.sessionTeam == team) release = i;
+	}
+	if (release >= 0) trap_DropClient(release, "Player took the stand-in's place", 0);
+}
+
+static void Emit(int slot, int team, int channel, int sit, const char *text)
+{
+	gentity_t *ent = &g_entities[slot];
+	(void)channel;
+	(void)sit;
+	if (ixvo_botChat.integer && IXVO_IsBot(slot) && ent->client && ent->client->sess.sessionTeam == team &&
+	    !ent->client->sess.muted && ent->health > 0)
+		G_Say(ent, NULL, SAY_TEAM, text);
+}
+
+void IXVO_BotFrame(void)
+{
+	int i, occupied = 0, lastFill = -1, target = ixvo_botMinPlayers.integer;
+	botChatFrame(level.time, Emit);
+	if (level.time < nextFill) return;
+	nextFill = level.time + 1000;
+	for (i = 0; i < level.maxclients; ++i)
+	{
+		if (level.clients[i].pers.connected != CON_DISCONNECTED) ++occupied;
+		if (roster[i].standinUntil && (level.time >= roster[i].standinUntil || !ixvo_botStandin.integer))
+		{
+			roster[i].standinUntil = 0;
+			roster[i].fill = qtrue;
+		}
+		if (roster[i].active && roster[i].fill && !roster[i].standinUntil) lastFill = i;
+	}
+	for (i = 0; i < level.maxclients; ++i)
+	{
+		ixvoVacancy_t *v = &vacancies[i];
+		if (!v->team) continue;
+		if (ixvo_botStandin.integer && occupied < level.maxclients - 1 && g_gamestate.integer == GS_PLAYING)
+		{
+			/* Mark as fill in userinfo so a map change releases its reservation. */
+			if (AddBot(3, v->team == TEAM_AXIS ? "red" : "blue", NULL, qtrue, v) >= 0) occupied++;
+		}
+		memset(v, 0, sizeof(*v));
+	}
+	if (target >= level.maxclients) target = level.maxclients - 1;
+	if (lastFill >= 0 && occupied > target) trap_DropClient(lastFill, "Adjusting bot fill", 0);
+	else if (occupied < target) AddBot(3, "auto", NULL, qtrue, NULL);
+}
+
+void IXVO_BotListen(gentity_t *human, const char *text)
+{
+	botlisten_t heard;
+	botchat_ctx_t ctx = {0};
+	const char *namesBySlot[MAX_CLIENTS] = {0}, *key;
+	int i, chosen = -1, speaker = (int)(human - g_entities);
+	if (!IXVO_BotsEnabled() || human->health <= 0 || human->client->sess.muted) return;
+	for (i = 0; i < level.maxclients; ++i)
+	{
+		gentity_t *bot = &g_entities[i];
+		if (!IXVO_IsBot(i) || bot->health <= 0 || !OnSameTeam(human, bot) ||
+		    COM_BitCheck(bot->client->sess.ignoreClients, speaker)) continue;
+		namesBySlot[i] = bot->client->pers.netname;
+		if (chosen < 0 || DistanceSquared(bot->r.currentOrigin, human->r.currentOrigin) <
+		    DistanceSquared(g_entities[chosen].r.currentOrigin, human->r.currentOrigin)) chosen = i;
+	}
+	if (chosen < 0 || !botListenParse(text, namesBySlot, level.maxclients, NULL, 0, &heard)) return;
+	if (heard.target >= 0) chosen = heard.target;
+	key = botListenReplyKey(heard.intent, 0);
+	if (BL_ORDER(heard.intent))
+	{
+		if (heard.addressed == BOTLISTEN_NONE) return;
+		if (heard.negated || heard.intent == BL_CANCEL)
+		{
+			roster[chosen].order = BL_NONE;
+			key = "ping_cancel";
+		}
+		else if (heard.intent == BL_DROP_BOMB)
+			key = botListenReplyKey(heard.intent, G_TCEManualDropBomb(&g_entities[chosen]));
+		else if (heard.intent == BL_HOLD || heard.intent == BL_WAIT || heard.intent == BL_FOLLOW || heard.intent == BL_REGROUP)
+		{
+			roster[chosen].order = heard.intent;
+			roster[chosen].leader = speaker;
+			roster[chosen].orderUntil = level.time + 15000;
+			key = botListenReplyKey(heard.intent, 1);
+		}
+		else key = "order_busy";
+	}
+	ctx.name = human->client->pers.netname;
+	if (ixvo_botChat.integer && key) botChatSay(level.time, chosen, human->client->sess.sessionTeam,
+	    chosen % BOTCHAT_PERS, botChatSituation(key), &ctx, BOTCHAT_FORCE);
+}
+
+qboolean IXVO_BotOrderMove(gentity_t *ent, usercmd_t *cmd)
+{
+	ixvoBot_t *b = &roster[ent->s.number];
+	gentity_t *leader;
+	vec3_t direction;
+	if (!b->active || !b->order) return qfalse;
+	leader = &g_entities[b->leader];
+	if (level.time >= b->orderUntil || ent->health <= 0 || !leader->inuse || leader->health <= 0 || !OnSameTeam(ent, leader))
+	{
+		b->order = BL_NONE;
+		return qfalse;
+	}
+	if (TCE_LocateEnemy(ent) && ent->enemy->health > 0 && TCE_MyVisible(ent, ent->enemy))
+		TCE_AttackEnemy(ent, cmd);
+	else if (b->order == BL_FOLLOW || b->order == BL_REGROUP)
+	{
+		VectorSubtract(leader->r.currentOrigin, ent->r.currentOrigin, direction);
+		vectoangles(direction, ent->s.angles);
+		if (VectorLength(direction) > 140 && TCE_CanMove(ent, 1) == 1) TCE_BotMove(ent, cmd, 1, 0);
+	}
+	return qtrue;
+}
+
+/* Platinum skill tables: first-shot reaction, target tracking lag and settling time. */
+static const int reaction[] = {0, 900, 650, 450, 300, 190};
+static const int trackLag[] = {0, 210, 160, 120, 85, 55};
+static const int settle[] = {0, 460, 360, 270, 200, 140};
+static const float aimError[] = {0, 6.5f, 4.2f, 2.6f, 1.6f, .9f};
+
+void IXVO_TrackTarget(gentity_t *ent, vec3_t target)
+{
+	ixvoBot_t *b = &roster[ent->s.number];
+	const int enemy = ent->enemy->s.number, skill = b->skill;
+	vec3_t delta, angles;
+	float weight;
+	VectorMA(target, -0.001f * trackLag[skill], ent->enemy->client->ps.velocity, target);
+	VectorSubtract(target, ent->r.currentOrigin, delta);
+	vectoangles(delta, angles);
+	if (enemy != b->enemy || level.time - b->seenAt > 350)
+	{
+		char area[64];
+		botchat_ctx_t ctx = {0};
+		if (ixvo_botChat.integer && Team_GetLocationMsg(ent->enemy, area, sizeof(area)))
+		{
+			ctx.area = area;
+			botChatSay(level.time, ent->s.number, ent->client->sess.sessionTeam, ent->s.number % BOTCHAT_PERS,
+			           botChatSituation("contact_one"), &ctx, 0);
+		}
+		float off = fabsf(AngleNormalize180(angles[YAW] - ent->client->ps.viewangles[YAW]));
+		float scale = off < 15 ? .72f : off > 60 ? 1.25f : 1.0f;
+		b->enemy = enemy;
+		b->shotAt = level.time + (int)(reaction[skill] * scale * (.85f + .30f * random()));
+		b->yaw = crandom() * aimError[skill];
+		b->pitch = crandom() * aimError[skill] * .5f;
+		b->driftAt = 0;
+	}
+	if (level.time >= b->driftAt)
+	{
+		float length = VectorLength(delta);
+		const float *v = ent->enemy->client->ps.velocity;
+		float lateral = fabsf(v[0] * delta[1] - v[1] * delta[0]) / (length > 1 ? length : 1);
+		b->wantYaw = crandom() * aimError[skill] * (1 + lateral / 160);
+		b->wantPitch = crandom() * aimError[skill] * .6f;
+		b->driftAt = level.time + 400 + rand() % 500;
+	}
+	weight = fminf(1, (level.time - b->aimAt) / (float)settle[skill]);
+	b->yaw += (b->wantYaw - b->yaw) * weight;
+	b->pitch += (b->wantPitch - b->pitch) * weight;
+	b->aimAt = b->seenAt = level.time;
+	angles[YAW] += b->yaw;
+	angles[PITCH] += b->pitch;
+	weight = VectorLength(delta);
+	AngleVectors(angles, delta, NULL, NULL);
+	VectorMA(ent->r.currentOrigin, weight, delta, target);
+}
+
+qboolean IXVO_BotReadyToFire(gentity_t *ent)
+{
+	trace_t tr;
+	vec3_t from, to;
+	if (level.time < roster[ent->s.number].shotAt) return qfalse;
+	VectorCopy(ent->r.currentOrigin, from);
+	from[2] += ent->client->ps.viewheight;
+	AngleVectors(ent->s.angles, to, NULL, NULL);
+	VectorMA(from, Distance(from, ent->enemy->r.currentOrigin), to, to);
+	trap_Trace(&tr, from, NULL, NULL, to, ent->s.number, MASK_SHOT);
+	if (tr.entityNum >= 0 && tr.entityNum < MAX_CLIENTS && g_entities[tr.entityNum].client &&
+	    OnSameTeam(ent, &g_entities[tr.entityNum])) return qfalse;
+	if (!ent->client->ps.ammoclip[BG_FindClipForWeapon(ent->client->ps.weapon)]) return qtrue; /* reload */
+	ixvoBot_t *b = &roster[ent->s.number];
+	if (ent->client->ps.persistant[10] != 0) /* native burst or semi-auto */
+	{
+		static const int tap[] = {0, 330, 270, 210, 170, 135};
+		if (level.time < b->nextTap) return qfalse;
+		b->nextTap = level.time + tap[b->skill] + rand() % 80;
+		return qtrue;
+	}
+	if (level.time < b->pauseUntil) return qfalse;
+	if (!b->fireUntil)
+	{
+		float dist = Distance(from, ent->enemy->r.currentOrigin);
+		b->fireUntil = level.time + (dist > 900 ? 180 : dist > 450 ? 300 : 650) + rand() % 150;
+	}
+	if (level.time < b->fireUntil) return qtrue;
+	b->fireUntil = 0;
+	b->pauseUntil = level.time + 160 + rand() % 220 + (6 - b->skill) * 40;
+	return qfalse;
+}
+
+/* Map Platinum's carry/defuse/escort roles to TCE2's live objective entities.
+ * The normal player cursor hint, hold timer and weapon event complete each action.
+ */
+static qboolean LiveCharge(const gentity_t *e)
+{
+	return e->inuse && (e->s.eType == ET_MISSILE || e->s.eType == 35) &&
+	       e->s.weapon == 15 && e->methodOfDeath == MOD_DYNAMITE && e->health < 248;
+}
+
+static void ObjectivePoint(const gentity_t *e, vec3_t point)
+{
+	if (e->s.eType == ET_OID_TRIGGER)
+	{
+		VectorAdd(e->r.absmin, e->r.absmax, point);
+		VectorScale(point, .5f, point);
+	}
+	else VectorCopy(e->r.currentOrigin, point);
+}
+
+static int FindObjective(gentity_t *ent)
+{
+	const int team = ent->client->sess.sessionTeam;
+	const int enemyFlag = team == TEAM_AXIS ? ALLIED_OBJECTIVE : AXIS_OBJECTIVE;
+	float nearest = 0;
+	int i, best = -1;
+	if (level.tceBombPlanted)
+	{
+		for (i = MAX_CLIENTS; i < level.num_entities; ++i)
+			if (LiveCharge(&g_entities[i]) && g_entities[i].s.teamNum != team) return i;
+	}
+	if (g_gametype.integer == 5 && !level.tceBombPlanted && level.tceBombAssigned &&
+	    level.tceBombCarrier >= 0 && level.tceBombCarrier < level.maxclients && level.tceBombCarrier != ent->s.number)
+	{
+		gentity_t *carrier = &g_entities[level.tceBombCarrier];
+		if (carrier->inuse && carrier->client && carrier->health > 0 && OnSameTeam(ent, carrier))
+			return level.tceBombCarrier;
+	}
+	for (i = MAX_CLIENTS; i < level.num_entities; ++i)
+	{
+		gentity_t *e = &g_entities[i];
+		vec3_t p;
+		float distance;
+		if (!e->inuse || !e->r.linked || e->s.eType != ET_OID_TRIGGER ||
+		    !e->target_ent || !e->target_ent->inuse ||
+		    !(e->spawnflags & (ALLIED_OBJECTIVE | AXIS_OBJECTIVE))) continue;
+		if (e->target_ent->s.eType != ET_EXPLOSIVE && !(g_gametype.integer == 2 && e->target_ent->s.eType == 65)) continue;
+		if (g_gametype.integer == 2 && !(e->spawnflags & enemyFlag)) continue;
+		ObjectivePoint(e, p);
+		distance = DistanceSquared(ent->r.currentOrigin, p);
+		if (best < 0 || distance < nearest) { best = i; nearest = distance; }
+	}
+	return best;
+}
+
+int IXVO_GoalNode(gentity_t *ent)
+{
+	ixvoBot_t *b = &roster[ent->s.number];
+	gentity_t *goal;
+	vec3_t p;
+	int n;
+	if (!tceNumNodes || (g_gametype.integer != 2 && g_gametype.integer != 5) ||
+	    g_gamestate.integer != GS_PLAYING || ent->client->ps.powerups[PW_REDFLAG] ||
+	    ent->client->ps.powerups[PW_BLUEFLAG]) return -1;
+	if (level.time < b->goalAt) return b->goalNode;
+	b->goalEntity = FindObjective(ent);
+	b->goalAt = level.time + 1500;
+	b->goalNode = -1;
+	if (b->goalEntity < 0) return -1;
+	goal = &g_entities[b->goalEntity];
+	ObjectivePoint(goal, p);
+	if (goal->s.eType == ET_OID_TRIGGER)
+	{
+		float nearest = 0;
+		for (n = 0; n < tceNumNodes; ++n)
+		{
+			const tceNode_t *node = &tceNodes[n];
+			const float *v = node->origin;
+			float d;
+			if (!node->numLinks || v[0] < goal->r.absmin[0] || v[0] > goal->r.absmax[0] ||
+			    v[1] < goal->r.absmin[1] || v[1] > goal->r.absmax[1] ||
+			    v[2] + 40 < goal->r.absmin[2] || v[2] - 24 > goal->r.absmax[2]) continue;
+			d = DistanceSquared(v, p);
+			if (b->goalNode < 0 || d < nearest) { b->goalNode = n; nearest = d; }
+		}
+	}
+	if (b->goalNode < 0) b->goalNode = TCE_FindClosestNodeToPoint(ent, p);
+	return b->goalNode;
+}
+
+qboolean IXVO_ObjectiveMove(gentity_t *ent, usercmd_t *cmd)
+{
+	ixvoBot_t *b = &roster[ent->s.number];
+	int hint;
+	gentity_t *goal;
+	vec3_t p, eye, d;
+	if (!b->active || ent->health <= 0 || g_gamestate.integer != GS_PLAYING) return qfalse;
+	hint = ent->client->ps.serverCursorHint;
+	if (hint == HINT_DISARM || hint == HINT_BREAKABLE_DYNAMITE ||
+	    (hint == HINT_ACTIVATE && ent->client->tceObjectiveContact))
+	{
+		cmd->buttons |= BUTTON_ACTIVATE;
+		return qtrue;
+	}
+	if (b->goalEntity < MAX_CLIENTS || b->goalEntity >= level.num_entities) return qfalse;
+	goal = &g_entities[b->goalEntity];
+	if (!goal->inuse || (goal->s.eType != ET_OID_TRIGGER && !LiveCharge(goal))) return qfalse;
+	if (goal->s.eType == ET_OID_TRIGGER && !(goal->spawnflags &
+	    (ent->client->sess.sessionTeam == TEAM_AXIS ? ALLIED_OBJECTIVE : AXIS_OBJECTIVE))) return qfalse;
+	if (goal->s.eType == ET_OID_TRIGGER && goal->target_ent && goal->target_ent->inuse)
+	{
+		VectorAdd(goal->target_ent->r.absmin, goal->target_ent->r.absmax, p);
+		VectorScale(p, .5f, p);
+	}
+	else ObjectivePoint(goal, p);
+	VectorCopy(ent->r.currentOrigin, eye);
+	eye[2] += ent->client->ps.viewheight;
+	VectorSubtract(p, eye, d);
+	if (VectorLength(d) > 88) return qfalse;
+	vectoangles(d, ent->s.angles);
+	if (TCE_CanMove(ent, 1) == 1) TCE_BotMove(ent, cmd, 1, 0);
+	return qtrue;
+}
+
+/* Adapt Platinum's least-visited-of-twelve patrols to TCE2's directed graph. */
+void IXVO_VisitNode(gentity_t *ent, int node)
+{
+	const int team = ent->client->sess.sessionTeam;
+	if (!ixvo_botExplore.integer || node < 0 || node >= tceNumNodes ||
+	    (team != TEAM_AXIS && team != TEAM_ALLIES)) return;
+	if (DistanceSquared(ent->r.currentOrigin, tceNodes[node].origin) <= 96 * 96)
+		lastVisit[team == TEAM_ALLIES][node] = level.time;
+}
+
+int IXVO_PatrolGoal(gentity_t *ent)
+{
+	short queue[TCE_MAX_NODES];
+	byte seen[TCE_MAX_NODES] = {0};
+	const int team = ent->client->sess.sessionTeam;
+	const int side = team == TEAM_ALLIES;
+	const int forbidden = side ? 0x20 : 0x10;
+	int head = 0, count = 0, draws, i, best = -1, bestScore = 0;
+	int start;
+
+	if (team != TEAM_AXIS && team != TEAM_ALLIES) return -1;
+	start = TCE_BotFindClosestNode(ent);
+	if (start < 0 || start >= tceNumNodes) return -1;
+	queue[count++] = (short)start;
+	seen[start] = 1;
+	while (head < count)
+	{
+		const tceNode_t *node = &tceNodes[queue[head++]];
+		for (i = 0; i < node->numLinks && i < TCE_MAX_NODE_LINKS; ++i)
+		{
+			const int next = node->links[i].target;
+			if (next < 0 || next >= tceNumNodes || seen[next] || (node->links[i].flags & 0x10) ||
+			    (tceNodes[next].flags & forbidden) || tceNodes[next].flags == -1) continue;
+			seen[next] = 1;
+			queue[count++] = (short)next;
+		}
+	}
+	/* Sample without replacement. Index zero is the starting node. */
+	draws = count - 1 < 12 ? count - 1 : 12;
+	for (i = 0; i < draws; ++i)
+	{
+		int pick = 1 + rand() % (count - 1);
+		int node = queue[pick];
+		int score = lastVisit[side][node];
+		queue[pick] = queue[--count];
+		if (reservedUntil[side][node] > level.time) score = reservedUntil[side][node];
+		if (best < 0 || score < bestScore)
+		{
+			best = node;
+			bestScore = score;
+		}
+	}
+	if (best >= 0)
+	{
+		ixvoBot_t *bot = &roster[ent->s.number];
+		reservedUntil[side][best] = level.time + 10000;
+		bot->patrolGoal = best;
+		++bot->patrolCount;
+	}
+	return best;
+}
