+qboolean IXVO_BotsEnabled(void)
+{
+#ifdef FEATURE_OMNIBOT
+	if (g_OmniBotEnable.integer) return qfalse;
+#endif
+	return ixvo_bots.integer != 0;
+}
+
+qboolean IXVO_IsBot(int slot)
+{
+	return slot >= 0 && slot < MAX_CLIENTS && roster[slot].active;
+}
+
+static int ClampSkill(int skill)
+{
+	return skill < 1 ? 1 : skill > 5 ? 5 : skill;
+}
+
+void IXVO_RestoreBot(int slot, const char *info)
+{
+	ixvoBot_t *b = &roster[slot];
+	TCE_ClearBotInfo(slot);
+	memset(b, 0, sizeof(*b));
+	b->active = qtrue;
+	b->patrolGoal = -1;
+	b->fill = atoi(Info_ValueForKey(info, "ixvo_fill")) != 0;
+	b->skill = ClampSkill(atoi(Info_ValueForKey(info, "skill")));
+	b->enemy = b->leader = b->goalEntity = b->goalNode = -1;
+	tceBotInfo[slot].skill = b->skill;
+}
+
+qboolean IXVO_BotKeepsLoadout(int slot)
+{
+	return IXVO_IsBot(slot) && roster[slot].standinUntil != 0;
+}
+
+void IXVO_ForgetBot(int slot)
+{
+	int i;
+	gentity_t *ent = &g_entities[slot];
+	gclient_t *c = ent->client;
+	if (IXVO_BotsEnabled() && ixvo_botStandin.integer && g_gamestate.integer == GS_PLAYING && !level.restarted &&
+	    !level.intermissiontime && !(ent->r.svFlags & SVF_BOT) && c && c->pers.connected == CON_CONNECTED &&
+	    (c->sess.sessionTeam == TEAM_AXIS || c->sess.sessionTeam == TEAM_ALLIES))
+	{
+		char info[MAX_INFO_STRING];
+		ixvoVacancy_t *v = &vacancies[slot];
+		v->team = c->sess.sessionTeam;
+		v->playerClass = c->sess.playerType;
+		v->primary = c->sess.playerWeapon;
+		v->secondary = c->sess.playerWeapon2;
+		v->utility = c->sess.playerWeapon3;
+		trap_GetUserinfo(slot, info, sizeof(info));
+		Q_strncpyz(v->guid, Info_ValueForKey(info, "cl_guid"), sizeof(v->guid));
+	}
+	botChatCancel(slot, -1);
+	memset(&roster[slot], 0, sizeof(roster[slot]));
+	for (i = 0; i < MAX_CLIENTS; ++i)
+	{
+		if (roster[i].leader == slot) roster[i].order = BL_NONE;
+		if (roster[i].enemy == slot) roster[i].enemy = -1;
+	}
+}
